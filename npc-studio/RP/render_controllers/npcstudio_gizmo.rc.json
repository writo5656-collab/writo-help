{
 "format_version": "1.10.0",
 "render_controllers": {
  "controller.render.npcstudio.gizmo": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Texture.default"
   ],
   "part_visibility": [
    {
     "*": true
    },
    {
     "arrows": "query.property('npcstudio:gmode') == 0"
    },
    {
     "rings": "query.property('npcstudio:gmode') == 1"
    },
    {
     "move_x": "!(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 1)"
    },
    {
     "move_x_on": "(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 1)"
    },
    {
     "rot_x": "!(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 1)"
    },
    {
     "rot_x_on": "(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 1)"
    },
    {
     "move_y": "!(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 2)"
    },
    {
     "move_y_on": "(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 2)"
    },
    {
     "rot_y": "!(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 2)"
    },
    {
     "rot_y_on": "(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 2)"
    },
    {
     "move_z": "!query.property('npcstudio:gaxis') == 3"
    },
    {
     "move_z_on": "query.property('npcstudio:gaxis') == 3"
    },
    {
     "rot_z": "!query.property('npcstudio:gaxis') == 3"
    },
    {
     "rot_z_on": "query.property('npcstudio:gaxis') == 3"
    },
    {
     "select": "query.property('npcstudio:gmode') == 2"
    }
   ],
   "ignore_lighting": true
  }
 }
}