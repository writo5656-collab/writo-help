{
 "format_version": "1.10.0",
 "render_controllers": {
  "controller.render.npcstudio.gizmo": {
   "geometry": "Geometry.default",
   "materials": [
    {
     "*": "Material.default"
    }
   ],
   "textures": [
    "Texture.default"
   ],
   "part_visibility": [
    {
     "*": false
    },
    {
     "root": true
    },
    {
     "center": "query.property('npcstudio:gmode') == 0 || query.property('npcstudio:gmode') == 1"
    },
    {
     "select": "query.property('npcstudio:gmode') == 2"
    },
    {
     "feet": "query.property('npcstudio:gmode') == 3"
    },
    {
     "move_x": "query.property('npcstudio:gmode') == 0 && (query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 1)"
    },
    {
     "move_x_dim": "query.property('npcstudio:gmode') == 0 && !(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 1)"
    },
    {
     "rot_x": "query.property('npcstudio:gmode') == 1 && (query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 1)"
    },
    {
     "rot_x_dim": "query.property('npcstudio:gmode') == 1 && !(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 1)"
    },
    {
     "move_y": "query.property('npcstudio:gmode') == 0 && (query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 2)"
    },
    {
     "move_y_dim": "query.property('npcstudio:gmode') == 0 && !(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 2)"
    },
    {
     "rot_y": "query.property('npcstudio:gmode') == 1 && (query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 2)"
    },
    {
     "rot_y_dim": "query.property('npcstudio:gmode') == 1 && !(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 2)"
    },
    {
     "move_z": "query.property('npcstudio:gmode') == 0 && (query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 3)"
    },
    {
     "move_z_dim": "query.property('npcstudio:gmode') == 0 && !(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 3)"
    },
    {
     "rot_z": "query.property('npcstudio:gmode') == 1 && (query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 3)"
    },
    {
     "rot_z_dim": "query.property('npcstudio:gmode') == 1 && !(query.property('npcstudio:gaxis') == 0 || query.property('npcstudio:gaxis') == 3)"
    }
   ],
   "ignore_lighting": true
  }
 }
}