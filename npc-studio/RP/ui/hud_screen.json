{
  "namespace": "hud",
  "hud_title_text": {
    "bindings": [
      {
        "binding_name": "#hud_title_text_string"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - 'npcs:') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "npcstudio_corner@hud.npcstudio_corner": {}
          }
        ]
      }
    ]
  },
  "npcstudio_corner": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [
      190,
      40
    ],
    "offset": [
      -3,
      3
    ],
    "layer": 30,
    "controls": [
      {
        "npcstudio_corner_text": {
          "type": "label",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "size": [
            "100%",
            "default"
          ],
          "text": "#text",
          "text_alignment": "right",
          "shadow": true,
          "localize": false,
          "color": [
            1,
            1,
            1
          ],
          "bindings": [
            {
              "binding_name": "#hud_title_text_string"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#hud_title_text_string - 'npcs:')",
              "target_property_name": "#text"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#hud_title_text_string - 'npcs:') = #hud_title_text_string))",
              "target_property_name": "#visible"
            }
          ],
          "font_scale_factor": 0.75
        }
      }
    ]
  }
}