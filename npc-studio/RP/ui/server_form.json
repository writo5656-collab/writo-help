{
 "namespace": "server_form",
 "third_party_server_screen": {
  "$screen_animations": [
   "@server_form.npcs_no_anim"
  ],
  "$background_animations": [
   "@server_form.npcs_no_anim"
  ],
  "render_game_behind": true
 },
 "npcs_no_anim": {
  "anim_type": "offset",
  "easing": "linear",
  "duration": 0,
  "from": [
   0,
   0
  ],
  "to": [
   0,
   0
  ],
  "play_event": "screen.exit_pop",
  "end_event": "screen.exit_end"
 },
 "main_screen_content": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "controls": [
   {
    "server_form_factory": {
     "type": "factory",
     "control_ids": {
      "long_form": "@server_form.npcs_router",
      "custom_form": "@server_form.custom_form"
     }
    }
   }
  ]
 },
 "npcs_router": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "controls": [
   {
    "vanilla@server_form.npcs_vanilla_wrap": {}
   },
   {
    "studio@server_form.npcs_panel_root": {}
   }
  ]
 },
 "npcs_vanilla_wrap": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "bindings": [
   {
    "binding_name": "#title_text"
   },
   {
    "binding_type": "view",
    "source_property_name": "((#title_text - '§n§p') = #title_text)",
    "target_property_name": "#visible"
   }
  ],
  "controls": [
   {
    "long_form@server_form.long_form": {}
   }
  ]
 },
 "npcs_panel_root": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "layer": 2,
  "bindings": [
   {
    "binding_name": "#title_text"
   },
   {
    "binding_type": "view",
    "source_property_name": "(not ((#title_text - '§n§p') = #title_text))",
    "target_property_name": "#visible"
   }
  ],
  "controls": [
   {
    "frame": {
     "type": "image",
     "texture": "textures/ui/npcstudio/panel/panel_bg",
     "size": [
      "40% + 40px",
      "100%"
     ],
     "max_size": [
      300,
      "100%"
     ],
     "anchor_from": "left_middle",
     "anchor_to": "left_middle",
     "layer": 2,
     "controls": [
      {
       "inner": {
        "type": "stack_panel",
        "orientation": "vertical",
        "size": [
         "100% - 10px",
         "100% - 8px"
        ],
        "offset": [
         0,
         4
        ],
        "anchor_from": "top_middle",
        "anchor_to": "top_middle",
        "controls": [
         {
          "header@server_form.npcs_header": {}
         },
         {
          "tabs@server_form.npcs_tabs": {}
         },
         {
          "rule": {
           "type": "image",
           "texture": "textures/ui/npcstudio/panel/rule",
           "size": [
            "100%",
            1
           ],
           "layer": 3
          }
         },
         {
          "gap": {
           "type": "panel",
           "size": [
            "100%",
            3
           ]
          }
         },
         {
          "scroll@server_form.npcs_scroll": {}
         }
        ]
       }
      }
     ]
    }
   }
  ]
 },
 "npcs_header": {
  "type": "stack_panel",
  "orientation": "horizontal",
  "size": [
   "100%",
   20
  ],
  "controls": [
   {
    "logo": {
     "type": "image",
     "texture": "textures/ui/npcstudio/logo",
     "size": [
      16,
      16
     ],
     "layer": 4
    }
   },
   {
    "pad": {
     "type": "panel",
     "size": [
      5,
      16
     ]
    }
   },
   {
    "title": {
     "type": "label",
     "size": [
      "fill",
      10
     ],
     "offset": [
      0,
      4
     ],
     "text": "#text",
     "color": [
      0.88,
      0.92,
      0.97
     ],
     "shadow": false,
     "layer": 4,
     "bindings": [
      {
       "binding_name": "#title_text"
      },
      {
       "binding_type": "view",
       "source_property_name": "((((#title_text - '§n§p§s§r') - '§n§p§t§r') - '§n§p§g§r') - '§n§p§h§r')",
       "target_property_name": "#text"
      }
     ]
    }
   },
   {
    "close@common.button": {
     "size": [
      16,
      16
     ],
     "$pressed_button_name": "button.menu_exit",
     "layer": 1,
     "controls": [
      {
       "default": {
        "type": "image",
        "texture": "textures/ui/npcstudio/panel/close",
        "size": [
         "100%",
         "100%"
        ]
       }
      },
      {
       "hover": {
        "type": "image",
        "texture": "textures/ui/npcstudio/panel/close_hover",
        "size": [
         "100%",
         "100%"
        ]
       }
      },
      {
       "pressed": {
        "type": "image",
        "texture": "textures/ui/npcstudio/panel/close_pressed",
        "size": [
         "100%",
         "100%"
        ]
       }
      }
     ]
    }
   }
  ]
 },
 "npcs_tabs": {
  "type": "stack_panel",
  "orientation": "horizontal",
  "size": [
   "100%",
   18
  ],
  "collection_name": "form_buttons",
  "bindings": [
   {
    "binding_name": "#title_text"
   },
   {
    "binding_type": "view",
    "source_property_name": "((not ((#title_text - '§n§p§t') = #title_text)) or (not ((#title_text - '§n§p§h') = #title_text)))",
    "target_property_name": "#visible"
   }
  ],
  "controls": [
   {
    "tab0@server_form.npcs_tab": {
     "collection_index": 0
    }
   },
   {
    "tab1@server_form.npcs_tab": {
     "collection_index": 1
    }
   },
   {
    "tab2@server_form.npcs_tab": {
     "collection_index": 2
    }
   },
   {
    "tab3@server_form.npcs_tab": {
     "collection_index": 3
    }
   },
   {
