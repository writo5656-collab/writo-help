{
 "namespace": "server_form",
 "third_party_server_screen": {
  "$screen_animations": [
   "@server_form.npcs_no_anim"
  ],
  "$background_animations": [
   "@server_form.npcs_no_anim"
  ],
  "render_game_behind": true
 },
 "npcs_no_anim": {
  "anim_type": "offset",
  "easing": "linear",
  "duration": 0,
  "from": [
   0,
   0
  ],
  "to": [
   0,
   0
  ],
  "play_event": "screen.exit_pop",
  "end_event": "screen.exit_end"
 },
 "main_screen_content": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "controls": [
   {
    "server_form_factory": {
     "type": "factory",
     "control_ids": {
      "long_form": "@server_form.npcs_router",
      "custom_form": "@server_form.custom_form"
     }
    }
   }
  ]
 },
 "npcs_router": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "controls": [
   {
    "vanilla@server_form.npcs_vanilla_wrap": {}
   },
   {
    "studio@server_form.npcs_editor": {}
   }
  ]
 },
 "npcs_vanilla_wrap": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "bindings": [
   {
    "binding_name": "#title_text"
   },
   {
    "binding_type": "view",
    "source_property_name": "((#title_text - '§n§p') = #title_text)",
    "target_property_name": "#visible"
   }
  ],
  "controls": [
   {
    "long_form@server_form.long_form": {}
   }
  ]
 },
 "npcs_editor": {
  "type": "panel",
  "size": [
   "100%",
   "100%"
  ],
  "layer": 2,
  "bindings": [
   {
    "binding_name": "#title_text"
   },
   {
    "binding_type": "view",
    "source_property_name": "(not ((#title_text - '§n§p') = #title_text))",
    "target_property_name": "#visible"
   }
  ],
  "controls": [
   {
    "left@server_form.npcs_left": {}
   },
   {
    "rail@server_form.npcs_rail": {}
   },
   {
    "bar@server_form.npcs_bar": {}
   }
  ]
 },
