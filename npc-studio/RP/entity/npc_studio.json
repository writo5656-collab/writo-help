        {
          "controller.render.npcstudio.default": "(query.property('npcstudio:skin_index') < 32) && math.mod(math.floor(query.property('npcstudio:flags') / 2), 2) == 0"
        },
        {
          "controller.render.npcstudio.bright": "(query.property('npcstudio:skin_index') < 32) && math.mod(math.floor(query.property('npcstudio:flags') / 2), 2) == 1"
        },
        {
          "controller.render.npcstudio.custom_model": "(query.property('npcstudio:skin_index') >= 32) && math.mod(math.floor(query.property('npcstudio:flags') / 64), 2) == 0 && math.mod(math.floor(query.property('npcstudio:flags') / 2), 2) == 0"
        },
        {
          "controller.render.npcstudio.custom_model_bright": "(query.property('npcstudio:skin_index') >= 32) && math.mod(math.floor(query.property('npcstudio:flags') / 64), 2) == 0 && math.mod(math.floor(query.property('npcstudio:flags') / 2), 2) == 1"
        },
        {
          "controller.render.npcstudio.outline": "(query.property('npcstudio:skin_index') < 32) && math.mod(query.property('npcstudio:flags'), 2) == 1 && math.mod(math.floor(query.property('npcstudio:flags') / 64), 2) == 0 && math.mod(math.floor(query.property('npcstudio:flags') / 512), 2) == 1"
        },
        {
          "controller.render.npcstudio.outline_sil": "(query.property('npcstudio:skin_index') < 32) && math.mod(query.property('npcstudio:flags'), 2) == 1 && math.mod(math.floor(query.property('npcstudio:flags') / 64), 2) == 0 && math.mod(math.floor(query.property('npcstudio:flags') / 512), 2) == 0"
        },
        {
          "controller.render.npcstudio.cape": "(query.property('npcstudio:skin_index') < 32) && (math.mod(math.floor(query.property('npcstudio:flags') / 4), 16) + math.mod(math.floor(query.property('npcstudio:flags') / 65536), 4) * 16 > 0) && math.mod(math.floor(query.property('npcstudio:flags') / 64), 2) == 0"
        }
      ],
