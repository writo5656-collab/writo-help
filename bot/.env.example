# Copy this file to .env and fill in the values. Never commit .env.
TIER_BOT_TOKEN=
GUILD_ID=
GROQ_API_KEY=
# Long random string shared with the mcbpvp-core Minecraft plugin.
# The /mcbpvp bridge stays OFF until this is set.
MCBPVP_SECRET=
PORT=3000
# Timezone that tournament hosts type times in (default India, +05:30).
TOURNAMENT_TZ_OFFSET=+05:30
