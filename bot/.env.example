# Copy this file to .env and fill in the values. Never commit .env.
TIER_BOT_TOKEN=
GUILD_ID=
GROQ_API_KEY=
# Long random string shared with the mcbpvp-core Minecraft plugin.
# The /mcbpvp bridge stays OFF until this is set.
MCBPVP_SECRET=
PORT=3000
# Optional. Default timezone for hosts who haven't run /tournament timezone.
# Players always see tournament times in their own timezone.
# TOURNAMENT_TIMEZONE=Asia/Kolkata

# Optional. Card colour: red (default), crimson, purple, blue, cyan, orange, pink, green, or a hex like #ff3355
# CARD_COLOR=red
